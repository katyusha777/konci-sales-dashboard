{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konci-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // All cron schedules run in UTC
    "crons": ["0 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
