generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

// Convention: all primary keys are UUIDv7 (time-ordered — rows sort by creation),
// generated client-side by Prisma via @default(uuid(7)) on native uuid columns.
// camelCase fields in code, snake_case in the database via @map / @@map.

// ─── Auth (UniFi Identity SSO — parked, see plan §9.1) ─────────────────────────

model User {
  id        String    @id @default(uuid(7)) @db.Uuid
  email     String    @unique
  name      String?
  unifiSub  String    @unique @map("unifi_sub")
  createdAt DateTime  @default(now()) @map("created_at")
  sessions  Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model HealthCheck {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

// ─── Leads (plan §3) ───────────────────────────────────────────────────────────

enum LeadSource {
  CSV
  SCRAPIO
  MANUAL
}

enum LeadStatus {
  NEW
  ENRICHED
  IN_CAMPAIGN
  CONTACTED
  ENGAGED
  REPLIED
  CLOSED_WON
  CLOSED_LOST
  DO_NOT_CONTACT
}

enum EnrichmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

model Lead {
  id            String  @id @default(uuid(7)) @db.Uuid
  name          String
  domain        String? @unique // normalized host, null for shared platforms — dedup key
  googlePlaceId String? @unique @map("google_place_id") // dedup key
  website       String?
  email         String?
  phone         String?

  street     String?
  city       String?
  state      String?
  postalCode String?  @map("postal_code")
  country    String?
  industry   String?
  categories String[]

  googleRating      Float? @map("google_rating")
  googleReviewCount Int?   @map("google_review_count")
  employeeCount     Int?   @map("employee_count")
  socialLinks       Json?  @map("social_links")

  // Enrichment extras (website mining / providers)
  services      String[]
  businessHours Json?    @map("business_hours")
  description   String?
  ownerName     String?  @map("owner_name")

  source     LeadSource
  sourceMeta Json?      @map("source_meta")

  enrichmentStatus   EnrichmentStatus @default(PENDING) @map("enrichment_status")
  enrichmentScore    Int              @default(0) @map("enrichment_score")
  enrichmentAttempts Int              @default(0) @map("enrichment_attempts")
  lastEnrichedAt     DateTime?        @map("last_enriched_at")
  enrichmentError    String?          @map("enrichment_error")

  status          LeadStatus @default(NEW)
  assignedTo      String?    @map("assigned_to")
  lastContactedAt DateTime?  @map("last_contacted_at")
  lastEngagedAt   DateTime?  @map("last_engaged_at")

  konciCustomerId String? @map("konci_customer_id")
  demoPhone       String? @map("demo_phone")
  demoPin         String? @map("demo_pin")

  // Outreach video (set automatically when a video render completes — newest wins;
  // pushed to Smartlead as video_url / video_thumbnail custom fields at sync time)
  videoUrl          String? @map("video_url")
  videoThumbnailUrl String? @map("video_thumbnail_url")

  // AI-picked (or manually set) decision-maker email — the send-to address for the
  // Smartlead sync. A manual pick is never overwritten by the AI (see S4b).
  outreachEmail       String? @map("outreach_email")
  outreachContactId   String? @map("outreach_contact_id") @db.Uuid // null = lead-level email
  outreachEmailReason String? @map("outreach_email_reason") // one-line AI justification

  totalCostUsd Decimal @default(0) @map("total_cost_usd") @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts            Contact[]
  notes               LeadNote[]
  costs               LeadCost[]
  enrichmentResponses EnrichmentResponse[]
  emails              Email[]
  videos              Video[]
  listMembers         LeadListMember[]
  konciRegistration   KonciRegistration?
  providerEmailStats  ProviderEmailStat[]

  @@index([status])
  @@index([enrichmentStatus])
  @@map("leads")
}

enum ContactSource {
  CSV
  SCRAPIO
  APOLLO
  MANUAL
  WEBSITE
  PDL
  HUNTER
  FULLENRICH
}

enum ContactEmailStatus {
  UNKNOWN
  VALID
  BOUNCED
  UNSUBSCRIBED
  COMPLAINED
}

model Contact {
  id          String             @id @default(uuid(7)) @db.Uuid
  leadId      String             @map("lead_id") @db.Uuid
  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  firstName   String?            @map("first_name")
  lastName    String?            @map("last_name")
  email       String?
  phone       String?
  jobTitle    String?            @map("job_title")
  linkedinUrl String?            @map("linkedin_url")
  priority    Int                @default(1) // send order within the lead
  emailStatus ContactEmailStatus @default(UNKNOWN) @map("email_status")
  source      ContactSource
  // Waterfall bookkeeping: confidence normalized 1–10 (save threshold ≥ 4);
  // enrichedAt is stamped even on a miss so a re-run never re-spends credits.
  confidence  Int?
  enrichedAt  DateTime?          @map("enriched_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  emails Email[]

  @@unique([leadId, email])
  @@map("contacts")
}

// ─── Lead lists (smartlead-integration.md §4 — S2) ─────────────────────────────

// Generic sending-provider tag (kept provider-agnostic — see smartlead-integration.md §2)
enum EmailProvider {
  SMARTLEAD
}

// A list only registers Konci accounts + syncs to the provider once ACTIVE —
// build the list, make videos, THEN activate.
enum ListStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ListSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

model LeadList {
  id          String     @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  status      ListStatus @default(DRAFT)

  // Link to the sending provider's campaign; null provider = not linked yet (S3)
  provider           EmailProvider?
  externalCampaignId String?        @map("external_campaign_id")
  lastSyncedAt       DateTime?      @map("last_synced_at")
  statsPulledAt      DateTime?      @map("stats_pulled_at") // stats-mirror watermark (S5)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members LeadListMember[]

  @@map("lead_lists")
}

model LeadListMember {
  id     String   @id @default(uuid(7)) @db.Uuid
  listId String   @map("list_id") @db.Uuid
  list   LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId String   @map("lead_id") @db.Uuid
  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // SKIPPED = no outreach email at sync time (fix + re-sync)
  syncStatus ListSyncStatus @default(PENDING) @map("sync_status")
  syncedAt   DateTime?      @map("synced_at")
  syncError  String?        @map("sync_error")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([listId, leadId])
  @@index([leadId])
  @@map("lead_list_members")
}

// The stats mirror (S5): one row per lead-email × sequence step in a provider
// campaign, upserted on every pull. leadId matched by email — nullable because a
// campaign may contain leads we didn't push.
model ProviderEmailStat {
  id                 String        @id @default(uuid(7)) @db.Uuid
  provider           EmailProvider
  externalCampaignId String        @map("external_campaign_id")
  externalLeadEmail  String        @map("external_lead_email")
  sequenceNumber     Int           @map("sequence_number")
  leadId             String?       @map("lead_id") @db.Uuid
  lead               Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sentAt             DateTime?     @map("sent_at")
  openCount          Int           @default(0) @map("open_count")
  clickCount         Int           @default(0) @map("click_count")
  repliedAt          DateTime?     @map("replied_at")
  bounced            Boolean       @default(false)
  raw                Json?
  pulledAt           DateTime      @default(now()) @map("pulled_at")

  @@unique([provider, externalCampaignId, externalLeadEmail, sequenceNumber])
  @@index([leadId])
  @@map("provider_email_stats")
}

// ─── Konci platform registration (test account on app.konci.ai for each lead) ───
// One row per lead; the cron polls PENDING rows until Konci's pipeline is terminal.
// A lead must be PREPARED (claim URL exists) before it may be synced to Smartlead.

enum KonciRegistrationStatus {
  PENDING
  PREPARED
  NEEDS_PHONE
  FAILED
  SKIPPED
}

model KonciRegistration {
  id             String                  @id @default(uuid(7)) @db.Uuid
  leadId         String                  @unique @map("lead_id") @db.Uuid
  lead           Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  konciLeadId    String                  @unique @map("konci_lead_id") // their lead_id
  status         KonciRegistrationStatus @default(PENDING)
  claimUrl       String?                 @map("claim_url")
  claimExpiresAt DateTime?               @map("claim_expires_at")
  error          String?
  raw            Json? // last GET response, verbatim
  lastPolledAt   DateTime?               @map("last_polled_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@map("konci_registrations")
}

model LeadNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("lead_notes")
}

enum CostType {
  ENRICHMENT
  VIDEO
  EMAIL
}

model LeadCost {
  id          String   @id @default(uuid(7)) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        CostType
  amountUsd   Decimal  @map("amount_usd") @db.Decimal(10, 4)
  description String
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("lead_costs")
}

// One row per provider call made during enrichment — the audit/debug ledger.
// Money aggregates live in lead_costs (one ENRICHMENT row per run).
enum EnrichmentProvider {
  GOOGLE_PLACES
  FIRECRAWL
  OPENROUTER
  PDL
  HUNTER
  FULLENRICH
  APOLLO
  SCRAPIO
}

model EnrichmentResponse {
  id         String             @id @default(uuid(7)) @db.Uuid
  leadId     String             @map("lead_id") @db.Uuid
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  provider   EnrichmentProvider
  operation  String // "lookup" | "scrape" | "extract_signals" | "company_enrich" | "find_email" | …
  request    Json // input params sent to the provider
  response   Json? // raw provider response (large markdown truncated)
  success    Boolean
  error      String?
  costUsd    Decimal            @default(0) @map("cost_usd") @db.Decimal(10, 4)
  durationMs Int                @map("duration_ms")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([leadId])
  @@map("enrichment_responses")
}

// ─── Avatars & Templates (plan §3 — backend lands in Phase B3) ────────────────

model Avatar {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  heygenAvatarId  String    @map("heygen_avatar_id")
  voiceId         String?   @map("voice_id")
  previewImageUrl String?   @map("preview_image_url")
  isActive        Boolean   @default(true) @map("is_active")
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  templates Template[]
  videos    Video[]

  @@map("avatars")
}

model Template {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  // Video, two modes: plain avatar video (avatarId + videoScript) or
  // HeyGen studio template (heygenTemplateId + videoScenes, one text per scene)
  avatarId         String?  @map("avatar_id") @db.Uuid
  avatar           Avatar?  @relation(fields: [avatarId], references: [id])
  voiceId          String?  @map("voice_id") // per-template override; falls back to the avatar's voice
  videoScript      String?  @map("video_script")
  heygenTemplateId String?  @map("heygen_template_id")
  videoScenes      String[] @map("video_scenes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  emails Email[]
  videos Video[]

  @@map("templates")
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

model Email {
  id                String        @id @default(uuid(7)) @db.Uuid
  leadId            String        @map("lead_id") @db.Uuid
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId         String?       @map("contact_id") @db.Uuid
  contact           Contact?      @relation(fields: [contactId], references: [id])
  templateId        String?       @map("template_id") @db.Uuid
  template          Template?     @relation(fields: [templateId], references: [id])
  subject           String
  providerMessageId String?       @map("provider_message_id")
  status            EmailStatus   @default(PENDING)
  trackingToken     String        @unique @map("tracking_token")
  wasTestMode       Boolean       @default(false) @map("was_test_mode")
  sentAt            DateTime?     @map("sent_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  events EmailEvent[]

  @@index([leadId])
  @@map("emails")
}

enum EmailEventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

model EmailEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  emailId    String         @map("email_id") @db.Uuid
  email      Email          @relation(fields: [emailId], references: [id], onDelete: Cascade)
  type       EmailEventType
  externalId String         @unique @map("external_id") // webhook idempotency
  payload    Json?
  occurredAt DateTime       @map("occurred_at")

  @@index([emailId])
  @@map("email_events")
}

// ─── Videos (plan §3 — backend lands in Phase B3) ─────────────────────────────

enum VideoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Video {
  id              String        @id @default(uuid(7)) @db.Uuid
  leadId          String        @map("lead_id") @db.Uuid
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  templateId      String?       @map("template_id") @db.Uuid
  template        Template?     @relation(fields: [templateId], references: [id])
  avatarId        String?       @map("avatar_id") @db.Uuid
  avatar          Avatar?       @relation(fields: [avatarId], references: [id])
  heygenVideoId   String        @map("heygen_video_id")
  status          VideoStatus   @default(PENDING)
  error           String?
  r2Key           String?       @map("r2_key") // downloaded from HeyGen → R2
  thumbnailR2Key  String?       @map("thumbnail_r2_key") // the email image, served at /api/v/:token/thumb
  durationSeconds Int?          @map("duration_seconds")
  token           String        @unique // public page /v/{token}
  costUsd         Decimal?      @map("cost_usd") @db.Decimal(10, 4)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  events VideoEvent[]

  @@index([status])
  @@map("videos")
}

enum VideoEventType {
  PAGE_VIEW
  PLAY
  PAUSE
  PROGRESS_25
  PROGRESS_50
  PROGRESS_75
  COMPLETED
}

model VideoEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  videoId         String         @map("video_id") @db.Uuid
  video           Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  type            VideoEventType
  positionSeconds Int?           @map("position_seconds")
  userAgent       String?        @map("user_agent")
  occurredAt      DateTime       @default(now()) @map("occurred_at")

  @@index([videoId])
  @@map("video_events")
}
